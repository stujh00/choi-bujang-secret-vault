{
  "schema": "aleph.xdr.patterns.v1",
  "moduleKey": "web-injection",
  "mitreTechnique": {
    "id": "T1190",
    "name": "Exploit Public-Facing Application"
  },
  "evaluationScope": "각 condition은 개별 alert 하나의 필드만 사용하며 다른 경보나 외부 상태를 요구하지 않습니다.",
  "conditionSemantics": {
    "all": "배열의 모든 조건을 만족해야 합니다.",
    "any": "배열의 조건 중 하나 이상을 만족해야 합니다.",
    "array_includes": "배열이 지정된 MITRE 기법을 포함합니다.",
    "non_empty_string": "필드가 공백이 아닌 문자열입니다.",
    "numeric_string_gte": "count 문자열을 안전하게 숫자로 변환해 지정값 이상인지 확인합니다.",
    "numeric_string_eq": "count 문자열을 안전하게 숫자로 변환해 지정값과 같은지 확인합니다.",
    "contains_any": "설명 문자열에 지정된 구체적 단서 중 하나 이상이 있습니다.",
    "url_path_in": "쿼리 전 URL 경로가 지정된 경로 중 하나와 정확히 같습니다.",
    "url_query_parameter_any": "URL 쿼리의 파라미터 이름이 지정된 이름 중 하나와 정확히 같습니다. 값은 출력하거나 정규화하지 않습니다."
  },
  "urlInspectionPolicy": "URL 원문은 인코딩하거나 디코딩하지 않습니다. 중복 디코딩을 하지 않으며, 이번 fixture의 공격 단서는 URL 본문이 아니라 Wazuh description에 기술되어 있습니다.",
  "patterns": [
    {
      "name": "반복 SQL Injection 의심",
      "mitre": ["T1190"],
      "classification": "high_confidence_candidate",
      "condition": {
        "all": [
          { "field": "rule.mitre", "operator": "array_includes", "value": "T1190" },
          { "field": "data.srcip", "operator": "non_empty_string" },
          { "field": "data.url", "operator": "url_path_in", "value": ["/notes", "/search", "/api/notes"] },
          { "field": "data.url", "operator": "url_query_parameter_any", "value": ["q", "id"] },
          { "field": "data.count", "operator": "numeric_string_gte", "value": 10 },
          {
            "field": "rule.description",
            "operator": "contains_any",
            "value": [
              "SQL 구문을 이어 붙인 요청",
              "SQL 구문 표기가 한 주소에서",
              "SQL 표식이 같은 주소에서 번갈아",
              "데이터베이스 조회를 이어 붙이는 표기"
            ]
          }
        ]
      },
      "evidence": "wi-01/04/05/08은 T1190, 웹 경로와 쿼리 파라미터, SQL 결합 설명 및 해당 경보 count 10~20이 함께 있습니다."
    },
    {
      "name": "반복 XSS 스크립트 삽입 표식",
      "mitre": ["T1190"],
      "classification": "high_confidence_candidate",
      "condition": {
        "all": [
          { "field": "rule.mitre", "operator": "array_includes", "value": "T1190" },
          { "field": "data.srcip", "operator": "non_empty_string" },
          { "field": "data.url", "operator": "url_path_in", "value": ["/search"] },
          { "field": "data.url", "operator": "url_query_parameter_any", "value": ["q"] },
          { "field": "data.count", "operator": "numeric_string_gte", "value": 9 },
          {
            "field": "rule.description",
            "operator": "contains_any",
            "value": ["스크립트 삽입 표기가", "스크립트 표식과 SQL 표식이 같은 주소에서 번갈아"]
          }
        ]
      },
      "evidence": "wi-02와 wi-05는 검색 쿼리에서 스크립트 삽입/표식 설명과 각각 9건·15건의 경보 내 반복 횟수가 있습니다."
    },
    {
      "name": "반복 Path Traversal 의심",
      "mitre": ["T1190"],
      "classification": "high_confidence_candidate",
      "condition": {
        "all": [
          { "field": "rule.mitre", "operator": "array_includes", "value": "T1190" },
          { "field": "data.srcip", "operator": "non_empty_string" },
          { "field": "data.url", "operator": "url_path_in", "value": ["/files"] },
          { "field": "data.url", "operator": "url_query_parameter_any", "value": ["path", "name"] },
          { "field": "data.count", "operator": "numeric_string_gte", "value": 8 },
          {
            "field": "rule.description",
            "operator": "contains_any",
            "value": ["경로를 여러 단계 거슬러 올라가는 표기", "경로 이탈 표기가 같은 주소에서"]
          }
        ]
      },
      "evidence": "wi-03/07은 /files의 path/name 쿼리와 상위 경로 이탈 설명, 해당 경보 count 8건·14건이 함께 있습니다."
    },
    {
      "name": "반복 명령 구분자 표식 (실행 징후 미확인)",
      "mitre": ["T1190"],
      "classification": "review_only",
      "condition": {
        "all": [
          { "field": "rule.mitre", "operator": "array_includes", "value": "T1190" },
          { "field": "data.srcip", "operator": "non_empty_string" },
          { "field": "data.url", "operator": "url_path_in", "value": ["/notes"] },
          { "field": "data.url", "operator": "url_query_parameter_any", "value": ["q"] },
          { "field": "data.count", "operator": "numeric_string_gte", "value": 2 },
          { "field": "rule.description", "operator": "contains_any", "value": ["명령 구분자 표기가 연속 요청"] }
        ]
      },
      "evidence": "wi-06은 명령 구분자 설명과 count 11이 있지만 실행 명령 징후는 확인되지 않아 Command Injection 확정이나 자동 차단 근거가 아닙니다."
    },
    {
      "name": "단일·모호한 주입 단서 추가 검토",
      "mitre": ["T1190"],
      "classification": "review_only",
      "condition": {
        "all": [
          { "field": "rule.mitre", "operator": "array_includes", "value": "T1190" },
          { "field": "data.srcip", "operator": "non_empty_string" },
          { "field": "data.url", "operator": "non_empty_string" },
          { "field": "data.count", "operator": "numeric_string_eq", "value": 1 },
          {
            "field": "rule.description",
            "operator": "contains_any",
            "value": [
              "검색어에 따옴표가 한 번",
              "select 라는 수업명이 한 번",
              "스크립트라는 수업 단어가 한 번",
              "경로에 up 이 한 번",
              "요청 주소가 평소보다 깁니다",
              "SQL 이라는 수업 공지 제목을 한 번",
              "이상한 검색 1건 뒤에 정상 조회",
              "주입처럼 보이는 표기가 1건",
              "구분 문자가 1건"
            ]
          }
        ]
      },
      "evidence": "wi-09~17은 모두 T1190과 count 1이지만 문구상 단일 문자·수업 단어·정상 후속 조회 등으로 반복 공격을 입증하지 않습니다."
    }
  ],
  "normalEventGuidance": {
    "fixtureIds": "wi-18~wi-26",
    "evidence": "일반 경보는 rule.mitre가 비어 있고 설명이 조회·화면 열기·새로고침·로그아웃 동작입니다. data.count 누락은 반복이 없다는 증거가 아니므로, count 부재만으로 정상 판정하지 않습니다."
  },
  "blockingGuidance": "높은 rule.level, T1190, URL 키워드, 같은 IP의 다른 경보만으로 자동 차단하지 않습니다. high_confidence_candidate도 해당 단일 경보의 설명과 count가 모두 일치해야 차단 후보가 되며, review_only는 차단 후보가 아닙니다."
}